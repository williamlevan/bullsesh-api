# Database
DATABASE_URL=postgresql://levanw@localhost:5432/bullsesh?schema=public

# JWT
JWT_SECRET="JWT_SECRET_HERE"
JWT_EXPIRES_IN="7d"

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In (get from Apple Developer Console)
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=4000
NODE_ENV=development

# API Key (required for all GraphQL requests)
API_KEY="API_KEY_HERE"

# CORS (comma-separated origins)
CORS_ORIGIN=*
